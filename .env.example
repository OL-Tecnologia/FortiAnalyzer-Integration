# FortiAnalyzer Reports — template (SEM senhas / SEM dados de cliente)
# Copie para .env e defina PORTAL_ADMIN_PASSWORD.
# Cadastre FAZ/ADOM/e-mail por cliente em /admin.html (não versionar tenants reais).

# --- Super Admin do portal (multi-tenant) ---
PORTAL_ADMIN_PASSWORD=troque_esta_senha
# PORTAL_ADMIN_SESSION_TTL_MINUTES=60
# CLIENTS_DIR=configs/clients

# --- FortiAnalyzer (legado / fallback — deixe vazio em instalação limpa) ---
FAZ_HOST=
FAZ_PORT=8090
FAZ_USE_SSL=true
FAZ_VERIFY_SSL=false

# --- Credenciais FAZ de automação (opcional) ---
FAZ_USER=
FAZ_PASSWORD=

# Sessao portal web (login FAZ na tela)
FAZ_SESSION_TTL_MINUTES=60
# FAZ_SESSION_COOKIE_SECURE=true

# --- ADOM e relatorios (legado) ---
FAZ_ADOM=
FAZ_REPORT_SCHEDULE=MENSAL- RELATÓRIO GERAL
FAZ_WAN_REPORT_SCHEDULE=
FAZ_TIME_PERIOD=last-30-days

# --- Cache e saida ---
OUTPUT_DIR=output
FAZ_MENSAL_CACHE_DIR=output/faz_mensal

# --- Assets PDF ---
PDF_ASSETS_DIR=assets
PDF_COVER_IMAGE=assets/cover.png
PDF_HEADER_IMAGE=assets/header.png
PDF_FOOTER_IMAGE=assets/footer.png

# --- Agendamento global (preferível por tenant no admin) ---
MENSAL_SCHEDULE_ENABLED=false
MENSAL_SCHEDULE_DAY=5
MENSAL_SCHEDULE_HOUR=6
MENSAL_SCHEDULE_MINUTE=0
MENSAL_SCHEDULE_TIMEZONE=America/Sao_Paulo
MENSAL_SCHEDULE_DAYS=60
MENSAL_SCHEDULE_FORCE_DOWNLOAD=true
MENSAL_SCHEDULE_RETRY_ENABLED=true
MENSAL_SCHEDULE_MAX_RETRIES=3
MENSAL_SCHEDULE_RETRY_HOURS=2

# --- SMTP (não versionar e-mails reais — LGPD) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USE_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=60
SMTP_FROM=
SMTP_TO=
SMTP_CC=
SMTP_ALERT_TO=
