# FortiAnalyzer Reports — template de distribuição (SEM senhas)
# Na primeira execução o .exe copia este arquivo para .env ao lado do executável.
# Preencha FAZ_PASSWORD e SMTP_PASSWORD no .env do servidor, ou use configurar-agendamento.bat

# --- FortiAnalyzer (conexão) ---
FAZ_HOST=172.16.8.39
FAZ_PORT=8090
FAZ_USE_SSL=true
FAZ_VERIFY_SSL=false

# --- Credenciais FAZ (configurável / segredo) ---
FAZ_USER=
FAZ_PASSWORD=

# Sessao portal web (login na tela — credenciais nao ficam aqui)
FAZ_SESSION_TTL_MINUTES=60
# FAZ_SESSION_COOKIE_SECURE=true

# --- ADOM e relatorios ---
FAZ_ADOM=CRUZ_AZUL
FAZ_REPORT_SCHEDULE=MENSAL- RELATÓRIO GERAL
FAZ_WAN_REPORT_SCHEDULE=SEMANAL- RELATÓRIO TRÁFEGO WAN
FAZ_TIME_PERIOD=last-30-days

# --- Cache e saida ---
OUTPUT_DIR=output
FAZ_MENSAL_CACHE_DIR=output/faz_mensal

# --- Assets PDF ---
PDF_ASSETS_DIR=assets
PDF_COVER_IMAGE=assets/cover.png
PDF_HEADER_IMAGE=assets/header.png
PDF_FOOTER_IMAGE=assets/footer.png

# --- Agendamento (configurável: dia / hora) ---
MENSAL_SCHEDULE_ENABLED=true
MENSAL_SCHEDULE_DAY=5
MENSAL_SCHEDULE_HOUR=6
MENSAL_SCHEDULE_MINUTE=0
MENSAL_SCHEDULE_TIMEZONE=America/Sao_Paulo
MENSAL_SCHEDULE_DAYS=60
MENSAL_SCHEDULE_FORCE_DOWNLOAD=true
MENSAL_SCHEDULE_RETRY_ENABLED=true
MENSAL_SCHEDULE_MAX_RETRIES=3
MENSAL_SCHEDULE_RETRY_HOURS=2

# --- SMTP (configurável: From / To / alerta) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USE_AUTH=true
SMTP_USER=notificacao@onelinea.com.br
SMTP_PASSWORD=
SMTP_TIMEOUT=60
SMTP_FROM=notificacao@onelinea.com.br
SMTP_TO=leandro.souza@cruzazulsp.com.br
SMTP_CC=
SMTP_ALERT_TO=roliveira@onelinea.com.br
