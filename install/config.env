# FortiAnalyzer Reports — template de distribuição (SEM senhas / SEM tenant)
# Na primeira execução o .exe copia este arquivo para .env ao lado do executável.
# Cadastre clientes no Super Admin (/admin.html). Não embute FAZ/e-mails de clientes (LGPD).

# --- Super Admin do portal (multi-tenant) ---
# Vazio de propósito. A primeira entrada em /admin.html cria a senha e grava aqui.
PORTAL_ADMIN_PASSWORD=
# PORTAL_ADMIN_SESSION_TTL_MINUTES=60
# CLIENTS_DIR=configs/clients

# --- FortiAnalyzer (legado / fallback — vazio na instalação limpa) ---
FAZ_HOST=
FAZ_PORT=8090
FAZ_USE_SSL=true
FAZ_VERIFY_SSL=false

# --- Credenciais FAZ de automação (opcional; preferível por tenant no admin) ---
FAZ_USER=
FAZ_PASSWORD=

# Sessao portal web (login na tela — credenciais nao ficam aqui)
FAZ_SESSION_TTL_MINUTES=60
# FAZ_SESSION_COOKIE_SECURE=true

# --- ADOM e relatorios (legado — vazio; use YAML por cliente) ---
FAZ_ADOM=
FAZ_REPORT_SCHEDULE=MENSAL- RELATÓRIO GERAL
FAZ_WAN_REPORT_SCHEDULE=
FAZ_TIME_PERIOD=last-30-days

# --- Cache e saida ---
OUTPUT_DIR=output
FAZ_MENSAL_CACHE_DIR=output/faz_mensal

# --- Assets PDF (faixas OL padrão; logo por cliente no admin) ---
PDF_ASSETS_DIR=assets
PDF_COVER_IMAGE=assets/cover.png
PDF_HEADER_IMAGE=assets/header.png
PDF_FOOTER_IMAGE=assets/footer.png

# --- Agendamento global (desligado; habilite por cliente no admin) ---
MENSAL_SCHEDULE_ENABLED=false
MENSAL_SCHEDULE_DAY=5
MENSAL_SCHEDULE_HOUR=6
MENSAL_SCHEDULE_MINUTE=0
MENSAL_SCHEDULE_TIMEZONE=America/Sao_Paulo
MENSAL_SCHEDULE_DAYS=60
MENSAL_SCHEDULE_FORCE_DOWNLOAD=true
MENSAL_SCHEDULE_RETRY_ENABLED=true
MENSAL_SCHEDULE_MAX_RETRIES=3
MENSAL_SCHEDULE_RETRY_HOURS=2

# --- SMTP (SEM destinatários — LGPD; preencher no .env local ou por tenant) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USE_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=60
SMTP_FROM=
SMTP_TO=
SMTP_CC=
SMTP_ALERT_TO=
