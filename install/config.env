# FortiAnalyzer JSON-RPC — Cruz Azul (pre-configurado)
FAZ_HOST=172.16.8.39
FAZ_PORT=8090
FAZ_USE_SSL=true
FAZ_VERIFY_SSL=false
FAZ_USER=
FAZ_PASSWORD=

# Sessao portal web (login na tela — credenciais nao ficam aqui)
FAZ_SESSION_TTL_MINUTES=60
# FAZ_SESSION_COOKIE_SECURE=true

# ADOM e relatorios
FAZ_ADOM=CRUZ_AZUL
FAZ_REPORT_SCHEDULE=MENSAL- RELATÓRIO GERAL
FAZ_WAN_REPORT_SCHEDULE=SEMANAL- RELATÓRIO TRÁFEGO WAN
FAZ_TIME_PERIOD=last-30-days

# Cache e saida
OUTPUT_DIR=output
FAZ_MENSAL_CACHE_DIR=output/faz_mensal

# Assets PDF
PDF_ASSETS_DIR=assets
PDF_COVER_IMAGE=assets/cover.png
PDF_HEADER_IMAGE=assets/header.png
PDF_FOOTER_IMAGE=assets/footer.png
