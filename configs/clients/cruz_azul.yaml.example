# Exemplo ilustrativo — NÃO é carregado (só *.yaml).
# Copie para cruz_azul.yaml e ajuste; não versionar e-mails/senhas (LGPD).
slug: cruz_azul
display_name: Cruz Azul
enabled: true
faz:
  host: 127.0.0.1
  port: 8090
  use_ssl: true
  verify_ssl: false
  adom: CRUZ_AZUL
  report_schedule_mensal: "MENSAL-RELATÓRIO DE ENDPOINT"
  report_schedule_wan: "SEMANAL- RELATÓRIO TRÁFEGO WAN"
  time_period: last-30-days
automation:
  faz_user: ""
  faz_password_env: FAZ_PASSWORD
hierarchy:
  device_pattern: '^(?:(?P<prefix>hafw\d+)|fw)-(?P<region>[a-z]+)-cruz-azul-(?P<site>.+)$'
  region_labels:
    spo: Unidade São Paulo (SPO)
pdf:
  cover_logo: assets/clients/cruz_azul/logo.png
  cover_logo_width_cm: 2.1
  cover_logo_align: right
  cover_logo_offset_x_cm: 0.0
  cover_logo_offset_y_cm: 0.35
  cover_header: assets/img/cabecalho_capa.png
  cover_footer: assets/img/rodape_capa.png
  internal_header: assets/img/cabecalho-interno.png
  header_logo: assets/img/logo-horizontal-gray.svg
  cover_title: RELATÓRIO MENSAL GERAL
  email_subject_prefix: Cruz Azul | Relatório Mensal FortiAnalyzer
output:
  subdir: cruz_azul
schedule:
  enabled: false
  day: 5
  hour: 6
  minute: 0
  timezone: America/Sao_Paulo
  days: 60
  force_download: true
  retry_enabled: true
  max_retries: 3
  retry_hours: 2
email:
  smtp_from: ""
  smtp_to: ""
  smtp_cc: ""
  smtp_alert_to: ""
